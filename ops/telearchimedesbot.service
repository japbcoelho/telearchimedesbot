[Unit]
Description=TeleArchimedesBot
Documentation=file:/opt/telearchimedesbot/current/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=telearchimedesbot
Group=telearchimedesbot
WorkingDirectory=/opt/telearchimedesbot/current
EnvironmentFile=/etc/telearchimedesbot/telearchimedesbot.conf
Environment=BOT_TOKEN_FILE=%d/bot-token
LoadCredentialEncrypted=bot-token:/etc/credstore.encrypted/telearchimedesbot-bot-token.cred
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/telearchimedesbot/current/.venv/bin/telearchimedesbot preflight
ExecStart=/opt/telearchimedesbot/current/.venv/bin/telearchimedesbot run
StateDirectory=telearchimedesbot
StateDirectoryMode=0700
CacheDirectory=telearchimedesbot
CacheDirectoryMode=0700
RuntimeDirectory=telearchimedesbot
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RemoveIPC=true
SocketBindDeny=any
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryHigh=128M
MemoryMax=256M
CPUQuota=50%
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStartSec=45
TimeoutStopSec=75

[Install]
WantedBy=multi-user.target
