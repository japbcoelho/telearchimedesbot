[Unit]
Description=Backup verificado do TeleArchimedesBot

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/telearchimedesbot/backup-state
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run /var/backups/telearchimedesbot /var/lib/telearchimedesbot
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=true
LimitCORE=0
LimitNOFILE=1024
TasksMax=16
MemoryMax=128M
TimeoutStartSec=120
